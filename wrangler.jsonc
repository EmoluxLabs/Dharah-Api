{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dharah-api",
  "main": "index.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dharah",
      "database_id": "d36e6888-8d1f-4587-97a2-842cc23d221c",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": { "crons": ["*/30 * * * *"] },

  "vars": {
    "API_URL": "https://api.dharah.ng",
    "CUSTOMER_URL": "https://www.dharah.ng",
    "ALLOWED_ORIGINS": "https://www.dharah.ng,https://dharah.ng,https://vendor.dharah.ng,https://riders.dharah.ng,https://admin.dharah.ng,https://kyc.dharah.ng,https://shipping.dharah.ng,https://finance.dharah.ng"
  }
}
